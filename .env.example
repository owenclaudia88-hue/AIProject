# Copy to .env.local for local dev, and set these in Vercel → Project → Settings →
# Environment Variables for the deployed site. Never commit real keys.

# Stripe API keys — https://dashboard.stripe.com/apikeys
# Use the test keys (sk_test_… / pk_test_…) until you have tested the full flow.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Webhook signing secret — https://dashboard.stripe.com/webhooks
# Locally, `stripe listen --forward-to localhost:3000/api/stripe-webhook` prints one.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Price charged, in the smallest currency unit. 100 = $1.00.
# Set server-side on purpose so the amount cannot be tampered with from the browser.
PRICE_AMOUNT=100
PRICE_CURRENCY=usd

# Membership subscription. When STRIPE_MONTHLY_PRICE_ID is set, the one-off
# purchase above ALSO saves the card and starts a recurring subscription on
# this Stripe Price, after a free trial of SUBSCRIPTION_TRIAL_DAYS days. Leave
# the price id blank to keep checkout as a one-off charge with no subscription.
# Create the recurring Price in Stripe (Products → add a recurring price).
STRIPE_MONTHLY_PRICE_ID=price_xxx
SUBSCRIPTION_TRIAL_DAYS=7

# --- Member area ---

# Neon Postgres connection string — https://neon.tech (free tier). Project →
# Connection Details → the pooled connection string.
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxx
# The verified sender address (a domain you've verified in Resend).
EMAIL_FROM=AI Founder University <hello@aifounderuniversity.com>

# Secret used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Where the site is reached, used to build login links in emails.
SITE_URL=https://aifounderuniversity.com

# Vercel Blob (member-area file storage) — Vercel → Storage → Blob → Tokens.
# Only the local upload tool needs this; the deployed site reads it from Vercel.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Comma-separated list of staff addresses. These accounts get the "Admin" badge
# on course comments and can delete any member's comment.
ADMIN_EMAILS=you@aifounderuniversity.com

# --- Lesson videos (Bunny Stream) ---

# Bunny Stream → your library → API. The library id and CDN hostname are shown
# at the top of that page; the API key is the one below them. The API key is
# only read by scripts/match-bunny-videos.mjs, never by the site.
BUNNY_STREAM_LIBRARY_ID=757685
BUNNY_STREAM_CDN_HOSTNAME=vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_STREAM_API_KEY=xxxxxxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxx-xxxx

# Pull zone → Security → Token Authentication → the security key, after turning
# token authentication on. Without it the playback URLs are unsigned, so anyone
# with the link can watch; with it they expire a few hours after they're issued.
BUNNY_STREAM_TOKEN_KEY=replace-with-the-pull-zone-token-key

# Which signature the pull zone expects — `npm run bunny:verify` reports it.
# This zone uses Basic token authentication, which is MD5.
BUNNY_STREAM_TOKEN_SCHEME=md5

# If the Stream library's token key is rejected, the pull zone has its own.
# Put it here and `npm run bunny:verify` will test both and say which works.
BUNNY_STREAM_TOKEN_KEY_ALT=
# Set by bunny:verify: 'dir' signs the video folder, 'file' just the playlist.
BUNNY_STREAM_TOKEN_PATH_MODE=dir

# --- Scheduled jobs ---
# Vercel Cron sends this as a bearer token. Without it the cron route refuses
# to run rather than sitting open — an unauthenticated endpoint that sends
# email is a gift to anyone who finds it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace-with-a-long-random-string
